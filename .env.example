# Copie este arquivo para ".env" e preencha os valores reais.
# Nenhuma dessas variáveis deve conter segredos — são apenas endereços/config
# pública consumida pelo frontend. O envio de e-mail em si acontece no
# backend/endpoint apontado por VITE_ENROLLMENT_API_ENDPOINT, nunca no navegador.

# Endpoint HTTP (função serverless, backend próprio ou serviço de formulários)
# que recebe o payload de matrícula em JSON e é responsável por notificar
# a secretaria (e-mail, CRM, etc.). Deixe em branco para desativar o envio
# automático — o site então orienta o visitante a continuar pelo WhatsApp.
VITE_ENROLLMENT_API_ENDPOINT=

# E-mail que deve receber as notificações de matrícula. Usado apenas como
# metadado/rótulo no frontend — o envio real do e-mail é responsabilidade
# do endpoint acima.
VITE_ENROLLMENT_CONTACT_EMAIL=amafrense@gmail.com

# Número de WhatsApp institucional em formato internacional, só dígitos
# (código do país + DDD + número). Usado para montar o link wa.me.
VITE_ENROLLMENT_WHATSAPP_NUMBER=5586994863802

# ---------------------------------------------------------------------------
# Variáveis do SERVIDOR (funções serverless em /api) — SEM prefixo VITE_.
# Nunca acessíveis pelo navegador. Configure-as em Project Settings →
# Environment Variables no painel da Vercel (não no arquivo .env do Vite).
# ---------------------------------------------------------------------------

# Chave de API do Resend (resend.com) — crie uma conta gratuita e gere uma
# API key em resend.com/api-keys. Usada pelas funções em /api para enviar
# e-mail de notificação de matrícula, contato e agendamento de visita.
RESEND_API_KEY=

# E-mail que deve receber as notificações (contato, matrícula, visita).
NOTIFY_EMAIL=

# Remetente configurado no Resend. Enquanto o domínio ieamafrense.com.br não
# estiver verificado no Resend, use o sandbox padrão abaixo — ele só entrega
# para o e-mail dono da conta Resend (deve ser igual a NOTIFY_EMAIL nesse
# caso). Depois de verificar o domínio, troque para algo como
# "IEAM <amafrense@gmail.com>" ou "IEAM <contato@ieamafrense.com.br>".
RESEND_FROM=IEAM — Site <onboarding@resend.dev>
